%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryColor": "#e8f1ff", "primaryTextColor": "#172b4d", "primaryBorderColor": "#345b86", "lineColor": "#475569", "secondaryColor": "#f1f5f9", "tertiaryColor": "#ffffff", "fontFamily": "Arial, sans-serif"}}}%%
C4Container
    title C4 Nivel 2 - Assistente de IA para Exportacao (proposta)
    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

    UpdateElementStyle(usuario, $fontColor="#17324d", $bgColor="#dbeafe", $borderColor="#2563eb")
    UpdateElementStyle(curador, $fontColor="#17324d", $bgColor="#dbeafe", $borderColor="#2563eb")
    UpdateElementStyle(oficiais, $fontColor="#17433a", $bgColor="#dcfce7", $borderColor="#15803d")
    UpdateElementStyle(llm, $fontColor="#17433a", $bgColor="#dcfce7", $borderColor="#15803d")
    UpdateElementStyle(web, $fontColor="#172b4d", $bgColor="#e0f2fe", $borderColor="#0369a1")
    UpdateElementStyle(api, $fontColor="#172b4d", $bgColor="#e0f2fe", $borderColor="#0369a1")
    UpdateElementStyle(val, $fontColor="#172b4d", $bgColor="#e0f2fe", $borderColor="#0369a1")
    UpdateElementStyle(db, $fontColor="#3b285d", $bgColor="#ede9fe", $borderColor="#7c3aed")
    UpdateElementStyle(q, $fontColor="#6b3c12", $bgColor="#fef3c7", $borderColor="#b45309")
    UpdateElementStyle(worker, $fontColor="#172b4d", $bgColor="#e0f2fe", $borderColor="#0369a1")

    Person(usuario, "Exportador", "Consulta orientacoes")
    Person(curador, "Curador", "Revisa fontes")
    System_Ext(oficiais, "Fontes oficiais", "Normas e portais")
    System_Ext(llm, "LLM externo", "Gera texto")

    System_Boundary(fiep, "Assistente Fiep") {
        Container(web, "Interface Web", "React", "Consultas e revisao")
        Container(api, "API", "Python / FastAPI", "Orquestra orientacoes")
        Container(val, "Validador", "Python", "Confere fontes e vigencia")
        ContainerDb(db, "Base normativa", "PostgreSQL", "Regras e evidencias")
        ContainerQueue(q, "Fila", "RabbitMQ", "Pedidos de revisao")
        Container(worker, "Worker", "Python", "Atualiza pendencias")
    }

    Rel(usuario, web, "Consulta", "HTTPS")
    Rel(curador, web, "Revisa", "HTTPS")
    Rel(web, api, "ConsultaDTO", "HTTPS/JSON")
    Rel(api, db, "Busca regras", "SQL/TCP")
    Rel(api, val, "Valida regras", "HTTP/JSON")
    Rel(val, db, "Busca fontes", "SQL/TCP")
    Rel(api, llm, "Gera resposta", "HTTPS/JSON")
    Rel(val, q, "Solicita revisao", "AMQP")
    Rel(q, worker, "Entrega evento", "AMQP")
    Rel(worker, oficiais, "Consulta normas", "HTTPS")
    Rel(worker, db, "Registra evidencias", "SQL/TCP")
